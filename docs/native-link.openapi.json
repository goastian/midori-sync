{
  "openapi": "3.1.0",
  "info": {
    "title": "Midori Link native save API",
    "version": "1.0.0",
    "description": "Implemented save receipts for the processed Link mode. URLs and titles are visible to the Link server. This contract does not advertise an incremental feed, offline client, conditional undo, or private Link. Sync native_ready remains false."
  },
  "servers": [
    {
      "url": "/api/library",
      "description": "Same explicitly selected instance as Sync; no automatic fallback"
    },
    {
      "url": "http://localhost:8000/api/library",
      "description": "Explicit local development only"
    },
    {
      "url": "https://sync.astian.org/api/library",
      "description": "Official instance"
    }
  ],
  "security": [
    {
      "SyncBearer": []
    }
  ],
  "paths": {
    "/v1/saves": {
      "post": {
        "operationId": "saveLink",
        "summary": "Save a link with a persistent operation receipt",
        "description": "Maximum request body: 32768 bytes. The UUID v4 operation_id is scoped to the authenticated account. Retrying identical effective data returns the original receipt and HTTP status, without checking current link existence, DNS, entitlement or collection existence. Changes to URL, title, collection or the normalized tag set return 409 idempotency_conflict. Tags are trimmed, lowercased, deduplicated and sorted for comparison; omitted/null optional fields have the same meaning. Unknown request fields are ignored. A new operation may return an existing canonical link without replacing it. The receipt and new link are committed atomically. A receipt is historical confirmation, not proof that a link still exists. The endpoint accepts the same bearer sessions as /links; fine-grained Link scopes are not implemented yet.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The original save reused an existing canonical link. Replays return the same receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveReceipt"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Contains no-store."
              }
            }
          },
          "201": {
            "description": "The original save created a link. Replays preserve 201 and created=true even if it has since been deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveReceipt"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Contains no-store."
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or revoked bearer session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "The link quota prevents a new link. The operation is not reserved. Reusing an existing link remains allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code",
                    "limit",
                    "used",
                    "upgrade_url"
                  ],
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "const": "plan_limit"
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "used": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "upgrade_url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "A supplied collection does not belong to this account or no longer exists. No new receipt or link is committed."
          },
          "409": {
            "description": "idempotency_conflict means the operation UUID already names different data. operation_capacity means this account already holds 100000 save receipts; existing receipts remain replayable. No new data is committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "idempotency_conflict",
                        "operation_capacity"
                      ]
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "The encoded request exceeds 32768 bytes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "request_too_large"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid request fields or invalid_url. No new data is committed.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "error"
                      ],
                      "properties": {
                        "error": {
                          "type": "string",
                          "const": "invalid_url"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "message",
                        "errors"
                      ],
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "errors": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Request rate limit reached; retry with backoff and the same operation UUID."
          },
          "500": {
            "description": "Uncertain outcome. Retain the original operation UUID and request for recovery; do not generate a new UUID."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SyncBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque Sync session token accepted by the selected joint Sync/Link instance; not a JWT."
      }
    },
    "schemas": {
      "SaveRequest": {
        "type": "object",
        "required": [
          "operation_id",
          "url"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Public HTTP(S) address under the existing Link URL policy. A missing scheme is normalized to HTTPS. Loopback API transport does not permit saving private fetch targets."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "library_collection_id": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "tags": {
            "type": [
              "array",
              "null"
            ],
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      },
      "SaveReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "operation_id",
          "link_id",
          "created"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "link_id": {
            "type": "string",
            "format": "uuid"
          },
          "created": {
            "type": "boolean",
            "description": "Whether this operation originally created the link. A replay preserves this value even after the link was edited or deleted."
          }
        }
      }
    }
  }
}
